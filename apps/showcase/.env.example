# THIS IS JUST AN EXAMPLE FILE, DO NOT COMMIT ANY CREDENTIALS HERE
NUXT_OAUTH_OIDC_CLIENT_ID=add-siam-client-id-here
NUXT_OAUTH_OIDC_CLIENT_SECRET=add-siam-client-secret-here
NUXT_OAUTH_OIDC_OPENID_CONFIG=https://federation-q.auth.schwarz/nidp/oauth/nam/.well-known/openid-configuration

# JFrog Artifactory for serving internal npm package assets (e.g. .css, .woff)
NUXT_JFROG_BASE_URL=https://your-company.jfrog.io/artifactory/api/npm/your-npm-repo
NUXT_JFROG_TOKEN=add-jfrog-personal-access-token-here