{
  "name": "onyx-monorepo",
  "license": "Apache-2.0",
  "author": "Schwarz Digits IT KG",
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build:all": "turbo run build build:storybook",
    "test:all": "vitest --coverage",
    "test:playwright:all": "turbo run test:playwright",
    "format:all": "oxfmt",
    "format:check:all": "oxfmt --check",
    "stylelint": "turbo run stylelint",
    "lint:all": "eslint .",
    "lint:fix:all": "pnpm run lint:all --fix",
    "lint:ci:all": "SARIF_ESLINT_IGNORE_SUPPRESSED=true pnpm run lint:all --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif",
    "publint:all": "pnpm -r --parallel --no-reporter-hide-prefix exec publint",
    "prepare": "simple-git-hooks",
    "gh:show-report": "./scripts/show-last-test-report.sh",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-community/eslint-utils": "^4.10.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@playwright/test": "catalog:",
    "@storybook/addon-docs": "~10.4.6",
    "@storybook/vue3-vite": "~10.4.6",
    "@tsconfig/node24": "^24.0.5",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "~0.9.1",
    "@vueless/storybook-dark-mode": "^10.0.8",
    "eslint": "^10.11.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-storybook": "~10.4.6",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vue-scoped-css": "^3.1.3",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "jsdom": "^30.1.0",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.5.1",
    "nuxt": "catalog:",
    "oxfmt": "~0.68.0",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "storybook": "~10.4.6",
    "stylelint": "^17.15.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "turbo": "^2.11.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "vue-tsc": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
