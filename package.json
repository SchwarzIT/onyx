{
  "name": "onyx-monorepo",
  "license": "Apache-2.0",
  "author": "Schwarz Digits IT KG",
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build:all": "turbo run build build:storybook",
    "test:all": "vitest --coverage",
    "test:playwright:all": "turbo run test:playwright",
    "format:all": "oxfmt",
    "format:check:all": "oxfmt --check",
    "stylelint": "turbo run stylelint",
    "lint:all": "eslint .",
    "lint:fix:all": "pnpm run lint:all --fix",
    "lint:ci:all": "SARIF_ESLINT_IGNORE_SUPPRESSED=true pnpm run lint:all --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif",
    "publint:all": "pnpm -r --parallel --no-reporter-hide-prefix exec publint",
    "prepare": "simple-git-hooks",
    "gh:show-report": "./scripts/show-last-test-report.sh",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint-community/eslint-utils": "^4.9.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@playwright/test": "catalog:",
    "@storybook/addon-docs": "~10.5.2",
    "@storybook/vue3-vite": "~10.5.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "~0.9.1",
    "@vueless/storybook-dark-mode": "^10.0.8",
    "eslint": "^10.7.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-storybook": "~10.5.2",
    "eslint-plugin-vue": "^10.9.2",
    "eslint-plugin-vue-scoped-css": "^3.1.1",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "lint-staged": "^17.1.0",
    "nuxt": "catalog:",
    "oxfmt": "~0.59.0",
    "publint": "^0.3.21",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "storybook": "~10.4.6",
    "stylelint": "^17.14.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "turbo": "^2.10.5",
    "typescript": "catalog:",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "vue-tsc": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}
