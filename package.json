{
  "name": "onyx-monorepo",
  "license": "Apache-2.0",
  "author": "Schwarz Digits IT KG",
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build:all": "turbo run build build:storybook",
    "test:all": "vitest --coverage",
    "test:playwright:all": "turbo run test:playwright",
    "format:all": "oxfmt",
    "format:check:all": "oxfmt --check",
    "stylelint": "turbo run stylelint",
    "lint:all": "eslint .",
    "lint:fix:all": "pnpm run lint:all --fix",
    "lint:ci:all": "SARIF_ESLINT_IGNORE_SUPPRESSED=true pnpm run lint:all --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif",
    "publint:all": "pnpm -r --parallel --no-reporter-hide-prefix exec publint",
    "prepare": "simple-git-hooks",
    "gh:show-report": "./scripts/show-last-test-report.sh",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-community/eslint-utils": "^4.10.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@playwright/test": "catalog:",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/vue3-vite": "^10.6.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "~0.9.1",
    "@vueless/storybook-dark-mode": "^10.0.8",
    "eslint": "^10.13.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vue-scoped-css": "^3.1.3",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "nuxt": "catalog:",
    "oxfmt": "~0.75.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "storybook": "^10.6.5",
    "stylelint": "^17.16.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "vue-tsc": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
