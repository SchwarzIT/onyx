{
  "name": "onyx-monorepo",
  "license": "Apache-2.0",
  "author": "Schwarz Digits IT KG",
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build:all": "turbo run build build:storybook",
    "test:all": "vitest --coverage",
    "test:playwright:all": "turbo run test:playwright",
    "format:all": "oxfmt",
    "format:check:all": "oxfmt --check",
    "stylelint": "turbo run stylelint",
    "lint:all": "eslint --cache .",
    "lint:fix:all": "pnpm run lint:all --fix",
    "lint:ci:all": "SARIF_ESLINT_IGNORE_SUPPRESSED=true pnpm run lint:all --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif",
    "publint:all": "pnpm -r --parallel --no-reporter-hide-prefix exec publint",
    "prepare": "simple-git-hooks",
    "gh:show-report": "./scripts/show-last-test-report.sh",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-community/eslint-utils": "^4.10.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@playwright/test": "catalog:",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/vue3-vite": "^10.6.8",
    "@tsconfig/node26": "^26.0.2",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "~0.9.1",
    "@vueless/storybook-dark-mode": "^10.0.8",
    "eslint": "^10.15.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-storybook": "^10.6.8",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vue-scoped-css": "^3.1.4",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "jsdom": "^31.0.1",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.2",
    "nuxt": "catalog:",
    "oxfmt": "~0.80.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.4",
    "simple-git-hooks": "^2.14.0",
    "storybook": "^10.6.8",
    "stylelint": "^18.1.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "vue-tsc": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4"
}
