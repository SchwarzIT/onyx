    "input.placeholderForeground": "#697985",
    "inputOption.activeBackground": "#00696e",
    "inputOption.activeBorder": "#00c3cd",
    "inputOption.activeForeground": "#e8fcfc",
    "inputValidation.errorBackground": "#55120e",
    "inputValidation.errorBorder": "#dc706e",
    "inputValidation.errorForeground": "#eaedf0",
    "inputValidation.warningBackground": "#593412",
    "inputValidation.warningBorder": "#f4b57e",
    "inputValidation.warningForeground": "#eaedf0",
    "inputValidation.infoBackground": "#311452",
    "inputValidation.infoBorder": "#a98ace",
    "inputValidation.infoForeground": "#eaedf0",

    "dropdown.background": "#11212d",
    "dropdown.foreground": "#eaedf0",
    "dropdown.border": "#22384a",
    "dropdown.listBackground": "#11212d",

    "button.background": "#00969d",
    "button.foreground": "#e8fcfc",
    "button.hoverBackground": "#00c3cd",
    "button.secondaryBackground": "#22384a",
    "button.secondaryForeground": "#eaedf0",
    "button.secondaryHoverBackground": "#31495c",

    "checkbox.background": "#11212d",
    "checkbox.foreground": "#eaedf0",
    "checkbox.border": "#22384a",

    "badge.background": "#00c3cd",
    "badge.foreground": "#000e19",

    "progressBar.background": "#00c3cd",

    "scrollbar.shadow": "#000e1966",
    "scrollbarSlider.background": "#22384a80",
    "scrollbarSlider.hoverBackground": "#31495caa",
    "scrollbarSlider.activeBackground": "#3e596ecc",

    "menu.background": "#11212d",
    "menu.foreground": "#eaedf0",
    "menu.border": "#22384a",
    "menu.selectionBackground": "#22384a",
    "menu.selectionForeground": "#eaedf0",
    "menu.separatorBackground": "#22384a",
    "menubar.selectionBackground": "#22384a",
    "menubar.selectionForeground": "#eaedf0",

    "notificationCenter.border": "#22384a",
    "notificationCenterHeader.background": "#11212d",
