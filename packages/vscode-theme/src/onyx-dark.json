    "notificationsErrorIcon.foreground": "#dc706e",
    "notificationsWarningIcon.foreground": "#f4b57e",
    "notificationsInfoIcon.foreground": "#a98ace",

    "gitDecoration.modifiedResourceForeground": "#f4b57e",
    "gitDecoration.deletedResourceForeground": "#dc706e",
    "gitDecoration.untrackedResourceForeground": "#6ebe94",
    "gitDecoration.ignoredResourceForeground": "#506e84",
    "gitDecoration.conflictingResourceForeground": "#a98ace",
    "gitDecoration.submoduleResourceForeground": "#3dd0d8",

    "textLink.foreground": "#3dd0d8",
    "textLink.activeForeground": "#79dde2",
    "textPreformat.foreground": "#79dde2",
    "textBlockQuote.background": "#11212d",
    "textBlockQuote.border": "#00969d",
    "textCodeBlock.background": "#000e19",
    "textSeparator.foreground": "#22384a",

    "breadcrumb.foreground": "#7392aa",
    "breadcrumb.focusForeground": "#eaedf0",
    "breadcrumb.activeSelectionForeground": "#00c3cd",
    "breadcrumbPicker.background": "#11212d",

    "debugToolBar.background": "#11212d",
    "debugToolBar.border": "#22384a",
    "debugIcon.breakpointForeground": "#d1332f",
    "debugIcon.breakpointDisabledForeground": "#697985",

    "settings.headerForeground": "#eaedf0",
    "settings.modifiedItemIndicator": "#00c3cd",
    "settings.dropdownBackground": "#11212d",
    "settings.dropdownBorder": "#22384a",
    "settings.checkboxBackground": "#11212d",
    "settings.checkboxBorder": "#22384a",
    "settings.textInputBackground": "#11212d",
    "settings.textInputBorder": "#22384a",

    "welcomePage.tileBackground": "#11212d",
    "welcomePage.tileHoverBackground": "#22384a",
    "welcomePage.progress.background": "#22384a",
    "welcomePage.progress.foreground": "#00c3cd",

    "charts.foreground": "#eaedf0",
    "charts.lines": "#22384a",
    "charts.red": "#dc706e",
    "charts.blue": "#56d8fc",
    "charts.yellow": "#f4b57e",
    "charts.orange": "#ff8a25",
    "charts.green": "#6ebe94",
    "charts.purple": "#a98ace"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#697985", "fontStyle": "italic" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#b7bfc5" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.other.readwrite", "variable.parameter"],
      "settings": { "foreground": "#eaedf0" }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "#a98ace", "fontStyle": "italic" }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "constant.numeric",
        "constant.character",
        "constant.other"
      ],
      "settings": { "foreground": "#f4b57e" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#6ebe94" }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#3dd0d8" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other"
      ],
      "settings": { "foreground": "#a98ace" }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#a98ace", "fontStyle": "italic" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.assignment"],
      "settings": { "foreground": "#79dde2" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": { "foreground": "#00c3cd" }
    },
    {
      "name": "Types / Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#3dd0d8" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter.function"],
      "settings": { "foreground": "#f6d1b1" }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.property.object",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": { "foreground": "#c2addc" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "meta.decorator entity.name.function", "punctuation.decorator"],
      "settings": { "foreground": "#f4b57e", "fontStyle": "italic" }
    },
    {
      "name": "Preprocessor / Directives",
      "scope": ["meta.preprocessor", "keyword.control.directive"],
      "settings": { "foreground": "#a98ace" }
    },

    {
      "name": "HTML/JSX Tags",
      "scope": ["entity.name.tag", "meta.tag entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#dc706e" }
    },
    {
      "name": "HTML/JSX Attributes",
      "scope": ["entity.other.attribute-name", "meta.tag entity.other.attribute-name"],
      "settings": { "foreground": "#f4b57e", "fontStyle": "italic" }
    },
    {
      "name": "JSX components",
      "scope": ["support.class.component", "entity.name.tag.jsx", "entity.name.tag.tsx"],
      "settings": { "foreground": "#3dd0d8" }
    },

    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": { "foreground": "#3dd0d8" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css"],
      "settings": { "foreground": "#c2addc" }
    },
    {
      "name": "CSS values",
      "scope": ["support.constant.property-value.css", "constant.other.color.rgb-value.css"],
      "settings": { "foreground": "#f4b57e" }
    },

    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#3dd0d8" }
    },
    {
      "name": "JSON string values",
      "scope": ["meta.structure.dictionary.value.json string"],
      "settings": { "foreground": "#6ebe94" }
    },

    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading punctuation.definition.heading",
        "entity.name.section"
      ],
      "settings": { "foreground": "#00c3cd", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": { "foreground": "#f4b57e", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": { "foreground": "#a98ace", "fontStyle": "italic" }
    },
    {
      "name": "Markdown link text",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#3dd0d8", "fontStyle": "underline" }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.raw"],
      "settings": { "foreground": "#79dde2" }
    },
    {
      "name": "Markdown quote",
      "scope": "markup.quote",
      "settings": { "foreground": "#b7bfc5", "fontStyle": "italic" }
    },
    {
      "name": "Markdown list punctuation",
      "scope": ["markup.list punctuation.definition.list.begin", "punctuation.definition.list"],
      "settings": { "foreground": "#00c3cd" }
    },

    {
      "name": "Diff added",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#6ebe94" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#dc706e" }
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "settings": { "foreground": "#f4b57e" }
    },

    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": { "foreground": "#eaedf0", "background": "#d1332f" }
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "settings": { "foreground": "#dc706e", "fontStyle": "strikethrough" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#3dd0d8",
    "type": "#3dd0d8",
    "class": "#3dd0d8",
    "interface": "#3dd0d8",
    "enum": "#3dd0d8",
    "typeParameter": { "foreground": "#79dde2", "italic": true },
    "function": "#00c3cd",
    "method": "#00c3cd",
    "macro": "#a98ace",
    "variable": "#eaedf0",
    "parameter": "#f6d1b1",
    "property": "#c2addc",
    "enumMember": "#f4b57e",
    "event": "#a98ace",
    "*.readonly": "#f4b57e",
    "*.deprecated": { "strikethrough": true },
    "*.declaration": { "bold": false }
  }
}
